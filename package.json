{
  "name": "macisland",
  "productName": "MacIsland",
  "version": "0.1.0",
  "description": "A macOS Dynamic Island and app-level Face Lock.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "MacIsland",
  "license": "UNLICENSED",
  "os": [
    "darwin"
  ],
  "scripts": {
    "dev": "npm run build:native && electron-vite dev",
    "build": "npm run typecheck && npm run build:native && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:extension",
    "typecheck:extension": "tsc --noEmit -p tsconfig.extension.json",
    "build:native": "sh native/swift-helper/build.sh"
  },
  "dependencies": {
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
