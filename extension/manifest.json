{
  "manifest_version": 3,
  "name": "MacIsland Connector",
  "version": "0.1.0",
  "description": "Shows what is playing and your downloads in MacIsland on your Mac. Talks only to MacIsland on this computer.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "alarms", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://soundcloud.com/*",
    "https://open.spotify.com/*",
    "https://music.apple.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://soundcloud.com/*",
        "https://open.spotify.com/*",
        "https://music.apple.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
